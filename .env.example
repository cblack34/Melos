# Copy to .env (gitignored). All Melos settings are optional — defaults target
# local dev with Ollama (see docs/tech-stack.md for the model choices).

# Generation backend: ai (default) | stub (deterministic canned song — for
# frontend dev without a running model)
#MELOS_GENERATION_BACKEND=ai

# Provider: ollama (default) | openrouter
#MELOS_LLM_PROVIDER=ollama

# Local Ollama endpoint. From docker compose the backend uses
# http://host.docker.internal:11434/v1 (set in docker-compose.yml).
#MELOS_OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-task models (generation / meta resolution / lyric writing). Ollama dev
# defaults below; OpenRouter production picks are anthropic/claude-sonnet-5,
# openai/gpt-5-nano, anthropic/claude-sonnet-5. On OpenRouter every one of the
# three must be a provider/model id.
#MELOS_GENERATION_MODEL=qwen3.6:27b
#MELOS_META_MODEL=qwen3.5:9b
#MELOS_LYRIC_MODEL=qwen3.6:27b

# Required only when MELOS_LLM_PROVIDER=openrouter. Never commit real keys.
#OPENROUTER_API_KEY=
